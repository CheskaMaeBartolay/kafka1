{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with authentication and role preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Google Auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "email", "createdAt"]
    },
    "Device": {
      "title": "Device",
      "description": "Registered device hardware entity for child or monitor",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string", "description": "Unique device UUID" },
        "userId": { "type": "string", "description": "Owner Google Auth UID" },
        "name": { "type": "string", "description": "User-assigned device name" },
        "model": { "type": "string", "description": "Device hardware model" },
        "mode": { "type": "string", "enum": ["MONITOR", "DEVICE"], "description": "Current operating mode" },
        "isOnline": { "type": "boolean", "description": "Online presence status" },
        "batteryPercentage": { "type": "integer", "description": "Battery percentage 0-100" },
        "isCharging": { "type": "boolean", "description": "Battery charging state" },
        "locationSharingPaused": { "type": "boolean", "description": "Child-controlled location pause flag" },
        "lastActive": { "type": "string", "format": "date-time", "description": "Last heartbeat timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["deviceId", "userId", "name", "model", "mode", "isOnline"]
    },
    "DevicePair": {
      "title": "DevicePair",
      "description": "Confirmed link between parent monitor and child device",
      "type": "object",
      "properties": {
        "pairId": { "type": "string", "description": "Pairing document ID" },
        "monitorDeviceId": { "type": "string", "description": "Parent device UUID" },
        "monitorUserId": { "type": "string", "description": "Parent UID" },
        "childDeviceId": { "type": "string", "description": "Child device UUID" },
        "childUserId": { "type": "string", "description": "Child UID" },
        "childDeviceName": { "type": "string", "description": "Child device display name" },
        "status": { "type": "string", "enum": ["ACTIVE", "PAUSED", "UNLINKED"], "description": "Pairing state" },
        "pairedAt": { "type": "string", "format": "date-time", "description": "Pairing timestamp" }
      },
      "required": ["pairId", "monitorDeviceId", "monitorUserId", "childDeviceId", "childUserId", "status"]
    },
    "PairingCode": {
      "title": "PairingCode",
      "description": "Short-lived 6-digit pairing code generated by monitor",
      "type": "object",
      "properties": {
        "code": { "type": "string", "description": "6-digit pairing code" },
        "monitorDeviceId": { "type": "string", "description": "Parent device UUID" },
        "monitorUserId": { "type": "string", "description": "Parent UID" },
        "monitorDeviceName": { "type": "string", "description": "Parent device name" },
        "isUsed": { "type": "boolean", "description": "Whether code has been consumed" },
        "expiresAt": { "type": "string", "format": "date-time", "description": "Expiration timestamp (5 min TTL)" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["code", "monitorDeviceId", "monitorUserId", "isUsed", "expiresAt", "createdAt"]
    },
    "LocationUpdate": {
      "title": "LocationUpdate",
      "description": "Real-time GPS coordinate telemetry from child device",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string", "description": "Child device UUID" },
        "userId": { "type": "string", "description": "Child UID" },
        "latitude": { "type": "number", "description": "Latitude coordinate" },
        "longitude": { "type": "number", "description": "Longitude coordinate" },
        "accuracy": { "type": "number", "description": "Location accuracy in meters" },
        "speed": { "type": "number", "description": "Speed in m/s" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Location recorded timestamp" }
      },
      "required": ["deviceId", "userId", "latitude", "longitude", "accuracy", "timestamp"]
    },
    "SessionRequest": {
      "title": "SessionRequest",
      "description": "Remote WebRTC camera or microphone session request and signaling",
      "type": "object",
      "properties": {
        "requestId": { "type": "string", "description": "Session request ID" },
        "monitorDeviceId": { "type": "string", "description": "Parent device UUID" },
        "monitorUserId": { "type": "string", "description": "Parent UID" },
        "childDeviceId": { "type": "string", "description": "Child device UUID" },
        "childUserId": { "type": "string", "description": "Child UID" },
        "sessionType": { "type": "string", "enum": ["CAMERA", "MIC"], "description": "Requested sensor" },
        "status": { "type": "string", "enum": ["PENDING", "ACCEPTED", "DECLINED", "ENDED"], "description": "Session state" },
        "offerSdp": { "type": "string", "description": "WebRTC offer SDP" },
        "answerSdp": { "type": "string", "description": "WebRTC answer SDP" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Request creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["requestId", "monitorDeviceId", "monitorUserId", "childDeviceId", "childUserId", "sessionType", "status", "createdAt"]
    },
    "SessionCandidate": {
      "title": "SessionCandidate",
      "description": "WebRTC ICE candidate for peer connection establishment",
      "type": "object",
      "properties": {
        "candidateId": { "type": "string", "description": "Candidate ID" },
        "sender": { "type": "string", "enum": ["MONITOR", "CHILD"], "description": "Sender role" },
        "sdpMid": { "type": "string", "description": "Media stream identification" },
        "sdpMLineIndex": { "type": "integer", "description": "Media stream index" },
        "sdp": { "type": "string", "description": "SDP candidate string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Candidate exchange timestamp" }
      },
      "required": ["candidateId", "sender", "sdpMid", "sdpMLineIndex", "sdp", "createdAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit trail log of safety events and sensor sessions",
      "type": "object",
      "properties": {
        "logId": { "type": "string", "description": "Log document ID" },
        "deviceId": { "type": "string", "description": "Associated device UUID" },
        "userId": { "type": "string", "description": "Actor user UID" },
        "eventType": { "type": "string", "description": "Event type descriptor" },
        "details": { "type": "string", "description": "Event description or metadata" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Event timestamp" }
      },
      "required": ["logId", "deviceId", "userId", "eventType", "details", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles isolated by user ID"
    },
    "/devices/{deviceId}": {
      "schema": "Device",
      "description": "Registered devices with status and telemetry"
    },
    "/device_pairs/{pairId}": {
      "schema": "DevicePair",
      "description": "Active pairing relationship between monitor and child"
    },
    "/pairing_codes/{code}": {
      "schema": "PairingCode",
      "description": "Temporary 6-digit pairing codes for device linking"
    },
    "/location_updates/{deviceId}": {
      "schema": "LocationUpdate",
      "description": "Current location telemetry of a child device"
    },
    "/session_requests/{requestId}": {
      "schema": "SessionRequest",
      "description": "Audio/video session requests and WebRTC signaling SDP"
    },
    "/session_candidates/{requestId}/candidates/{candidateId}": {
      "schema": "SessionCandidate",
      "description": "WebRTC ICE candidates exchanged during active session setup"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Transparent security and activity audit records"
    }
  }
}
